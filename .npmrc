# pnpm is the only supported package manager for this repo.
# `npm install` at the root previously produced a corrupt tree (npm-flattened
# node_modules while the workspace declared pnpm), which forked `viem` into
# multiple resolved copies and broke typechecking repo-wide.
engine-strict=true

# React-context singletons.
#
# wagmi, viem and react-query all publish React context. If two physical copies
# of one of them exist, a Provider writes to copy A's context while a hook in
# another workspace package reads copy B's — the provider appears "not found"
# even though it is mounted. That exact fault broke the production build:
# apps/web and packages/web3 resolved to two different wagmi instances.
#
# Hoisting them keeps exactly one copy for the whole workspace.
public-hoist-pattern[]=viem
public-hoist-pattern[]=abitype
public-hoist-pattern[]=wagmi
public-hoist-pattern[]=@tanstack/react-query
public-hoist-pattern[]=@tanstack/query-core
public-hoist-pattern[]=@privy-io/*
public-hoist-pattern[]=@circle-fin/*
public-hoist-pattern[]=*types*

# Resolve peer dependencies to a single copy rather than forking a package per
# unique peer-hash. Without this, declaring wagmi as BOTH a peer and a dev
# dependency produces two store entries with different suffixes.
dedupe-peer-dependents=true

# Deterministic installs in CI.
strict-peer-dependencies=false
auto-install-peers=true
