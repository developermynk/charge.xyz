# pnpm is the only supported package manager for this repo.
# `npm install` at the root previously produced a corrupt tree (npm-flattened
# node_modules while the workspace declared pnpm), which forked `viem` into
# multiple resolved copies and broke typechecking repo-wide.
engine-strict=true

# Circle SDKs and wagmi/viem rely on a single hoisted viem instance.
# Keeping these public prevents duplicate copies under nested node_modules.
public-hoist-pattern[]=viem
public-hoist-pattern[]=abitype
public-hoist-pattern[]=@circle-fin/*
public-hoist-pattern[]=*types*

# Deterministic installs in CI.
strict-peer-dependencies=false
auto-install-peers=true
