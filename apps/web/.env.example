# Deployer wallet private key (for contract deployment)
PRIVATE_KEY=

# Alchemy RPC URL (used by both Hardhat and the frontend)
NEXT_PUBLIC_ALCHEMY_RPC_URL=

# Circle modular wallets (required for the smart account created on Privy login)
NEXT_PUBLIC_CIRCLE_CLIENT_KEY=
NEXT_PUBLIC_CIRCLE_CLIENT_URL=

# Privy — login + create account (embedded wallet becomes the Circle smart-account owner)
# Get an app id from https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=

# WalletConnect (optional — enables the WalletConnect option under "Continue with wallet")
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Contract addresses (auto-written by deploy script)
# NEXT_PUBLIC_MARKET_ADDRESS=0x...
# NEXT_PUBLIC_AMM_ADDRESS=0x...
# NEXT_PUBLIC_ARCT_ADDRESS=0x...
# NEXT_PUBLIC_OO_V2_ADDRESS=0x...
# NEXT_PUBLIC_FINDER_ADDRESS=0x...
# NEXT_PUBLIC_TIMER_ADDRESS=0x...
# NEXT_PUBLIC_MOCK_ORACLE_ADDRESS=0x...

# ── Circle Swap Kit (SERVER-SIDE ONLY — never expose to the client/browser) ──
# Kit key from Circle Developer Console → Keys → Create a key → "Kit Key".
# Network-agnostic: same key works on mainnet and testnet.
KIT_KEY=

# Circle developer-controlled wallets (used by the swap backend's signing adapter)
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# Address of the Circle developer-controlled wallet that signs swaps and holds
# the funds being swapped. Create it via the Circle console / Wallets API.
WALLET_ADDRESS=

# Optional developer fee on every swap (percentage-based). Leave both blank to
# disable. When SWAP_FEE_RECIPIENT is set, SWAP_FEE_BPS becomes REQUIRED
# (integer 1–10000 = 0.01%–100%). Circle keeps 10% of the fee; the recipient
# gets the other 90%. The recipient MUST be valid on the swap's origin chain.
# SWAP_FEE_RECIPIENT=0xyour_fee_recipient_address
# SWAP_FEE_BPS=25
