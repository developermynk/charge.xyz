# Circle API Configuration
CIRCLE_API_KEY=your_circle_api_key_here
CIRCLE_ENTITY_SECRET=your_entity_secret_here
KIT_KEY=your_kit_key_from_circle_console

# Wallet Configuration (Choose ONE approach)

# Option 1: Self-custodied private key (EVM)
PRIVATE_KEY=0x_your_private_key_here

# Option 2: Circle Developer-Controlled Wallets
CIRCLE_API_KEY=your_api_key
CIRCLE_ENTITY_SECRET=your_entity_secret
EVM_WALLET_ADDRESS=0x_your_wallet_address
SOLANA_WALLET_ADDRESS=your_solana_wallet_address

# Option 3: For Solana bridging
SOLANA_PRIVATE_KEY=your_base58_solana_private_key
EVM_PRIVATE_KEY=0x_your_evm_private_key

# Server Configuration
PORT=3000
NODE_ENV=development

# Supported Chains (for validation)
SUPPORTED_CHAINS=Ethereum,Base,Arbitrum,Optimism,Polygon,Avalanche,Arc_Testnet,Base_Sepolia,Ethereum_Sepolia,Arbitrum_Sepolia,Polygon_Amoy,Solana,Solana_Devnet

# Default Slippage (basis points, 300 = 3%)
DEFAULT_SLIPPAGE_BPS=300

# Fee Configuration
CUSTOM_FEE_PERCENTAGE_BPS=100
CUSTOM_FEE_RECIPIENT=0x_your_fee_recipient_address

# Smart Contract Platform
SCP_WALLET_ID=your_wallet_id_for_deployments