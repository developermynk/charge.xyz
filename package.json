{
  "name": "charge-xyz",
  "version": "2.0.0",
  "private": true,
  "description": "Charge.xyz — the USDC-native control panel for Arc. Swap, bridge, mint and send on Circle's Arc L1 where USDC is the gas.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:secrets": "node scripts/check-client-secrets.mjs",
    "check:singletons": "node scripts/check-singletons.mjs",
    "verify": "pnpm check:singletons && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:secrets"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "viem": "2.47.5",
      "wagmi": "3.7.6",
      "@tanstack/react-query": "5.101.4",
      "zod": "3.25.76",
      "use-sync-external-store": "1.6.0"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "viem": "2",
        "wagmi": "3"
      }
    }
  }
}
